{
  "name": "vpn-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "browserslist": [
    "Chrome >= 51",
    "Android >= 6"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "npm run i18n:pack && npm run i18n:audit && tsc -b && vite build",
    "preview": "vite preview --host --port 80",
    "test:logs": "tsx --test tests/vpn-log-time.test.ts tests/vpn-log-html.test.ts",
    "test:i18n": "tsx --test tests/countries-i18n.test.tsx tests/i18n-coverage.test.tsx tests/i18n-source.test.mjs",
    "i18n:pack": "node scripts/pack-i18n-messages.mjs",
    "i18n:countries": "tsx scripts/generate-country-messages.ts",
    "i18n:audit": "node scripts/i18n-source.mjs --check",
    "check:i18n-size": "node scripts/check-i18n-size.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "fflate": "0.8.3",
    "lucide-react": "0.525.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vtunnel-sdk": "^2.9.0"
  },
  "devDependencies": {
    "@babel/highlight": "^7.25.9",
    "@types/jsdom": "^21.1.7",
    "@types/node": "24.0.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "4.6.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "postcss": "8.5.6",
    "postcss-inset": "^1.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "4.20.5",
    "typescript": "^5.5.3",
    "vite": "7.0.2"
  }
}
